# ============================================================
# FastAPI 开箱即用模板 配置文件
# 复制为 .env 后按需修改；或通过环境变量覆盖（环境变量优先）
# ============================================================

# ---------- 应用基础 ----------
APP_NAME = 安全管控平台模板
API_PREFIX = /api/v1
DEBUG = true

# ---------- 认证方式 (jwt | session) ----------
AUTH_MODE = jwt

# ---------- JWT 认证配置（AUTH_MODE=jwt 时生效）----------
JWT_SECRET = change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM = HS256
JWT_ACCESS_EXPIRE_MINUTES = 30
JWT_REFRESH_EXPIRE_DAYS = 7

# ---------- Session 认证配置（AUTH_MODE=session 时生效）----------
# session 会话保存到的表名服务器端，客户端只拿一个 session_id（HttpOnly Cookie）
SESSION_EXPIRE_HOURS = 8
SESSION_COOKIE_NAME = session_id
SESSION_COOKIE_SECURE = false
SESSION_COOKIE_HTTPONLY = true

# ---------- 数据库（sqlite | mongodb）----------
DB_BACKEND = sqlite
# sqlite 后端：文件路径（相对 backend/ 或绝对路径）
DATABASE_URL = sqlite+aiosqlite:///../data/app.db
# mongodb 后端：完整连接串；未配置启用 mongodb 会报错
MONGO_URI = mongodb://localhost:27017
MONGO_DB = app_template

# ---------- 验证码（登录防爆破）----------
# 是否启用登录验证码（建议生产开启）
CAPTCHA_ENABLED = true
CAPTCHA_LENGTH = 4
CAPTCHA_EXPIRE_SECONDS = 300

# ---------- 账户锁定（暴力破解防护）----------
# 登录失败次数上限（含验证码错误，用户名/IP 双维度共用计数）
LOGIN_MAX_FAILURES = 5
# 验证码失败次数上限（与登录共用计数）
CAPTCHA_MAX_FAILURES = 3
# 命中上限后的锁定时间（秒），0 = 不锁定
LOCK_SECONDS = 300
# 是否信任 X-Forwarded-For 代理头（Nginx 后置部署建议 true）
LOCK_TRUST_PROXY = true

# ---------- 密码策略（长度/复杂度；建号/自助改密/管理员重置统一校验）----------
PASSWORD_MIN_LENGTH = 8
PASSWORD_REQUIRE_UPPER = true
PASSWORD_REQUIRE_LOWER = true
PASSWORD_REQUIRE_DIGIT = true
PASSWORD_REQUIRE_SPECIAL = false

# ---------- 定期修改密码（jwt/session 两种认证模式通用；0 = 不启用）----------
# 密码有效期（天），到期后除改密/登出等豁免接口外，业务接口返回 428 拒绝
PASSWORD_EXPIRE_DAYS = 90
# 到期前 N 天登录响应带 password_expire_warning 提醒
PASSWORD_EXPIRE_WARNING_DAYS = 7
# 记录最近 N 个历史密码并拒绝重用（0 = 不记录）
PASSWORD_HISTORY_COUNT = 5

# ---------- 日志 ----------
LOG_LEVEL = INFO
LOG_DIR = ../data/logs

# ---------- 定时任务（参考产品 inputs.conf 风格）----------
# 定时任务声明的配置文件路径（相对 backend/，留空用默认 backend/conf/inputs.conf）
# SCHEDULE_CONF =
SCHEDULE_ENABLED = true

# ---------- 部署（systemd 安装使用）----------
# 服务运行用户（install.sh 会写入 systemd unit）
SERVICE_USER = admin
SERVICE_GROUP = admin
